FROM python:3.11-slim

WORKDIR /app

# Instala ferramentas essenciais do sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copia e instala as dependências iniciais (para cache de build)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Expõe a porta interna do backend
EXPOSE 8000

# Garante a atualização de dependências e inicia o Uvicorn com hot-reload
CMD ["sh", "-c", "pip install --no-cache-dir -r requirements.txt && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"]
